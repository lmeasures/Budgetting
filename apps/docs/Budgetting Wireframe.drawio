                <mxCell id="Ohu_rihZBkmFTRXGpnVS-62" value="&lt;h1&gt;Req. Notes&lt;br&gt;&lt;/h1&gt;&lt;div&gt;-leftover monies display like in the prototype&lt;/div&gt;&lt;div&gt;-- Bills, bills unpaid, bills paid, remaining from pay&lt;br&gt;&lt;/div&gt;" style="text;html=1;strokeColor=#2D7600;fillColor=#60a917;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;fontColor=#ffffff;" parent="1" vertex="1">
