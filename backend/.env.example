# API Configuration

# Environment
NODE_ENV=development

# Server
PORT=3001
API_URL=http://localhost:3001

# Frontend URLs (for CORS)
FRONTEND_URL_DEV=http://localhost:3000
FRONTEND_URL_STAGING=https://staging.budgetting.app
FRONTEND_URL_PROD=https://budgetting.app

# Database
MONGODB_URI_DEV=mongodb://localhost:27017/budgetting-dev
MONGODB_URI_STAGING=mongodb+srv://username:password@cluster.mongodb.net/budgetting-staging?retryWrites=true&w=majority
MONGODB_URI_PROD=mongodb+srv://username:password@cluster.mongodb.net/budgetting-prod?retryWrites=true&w=majority

# JWT Configuration
JWT_SECRET=your-super-secret-key-change-this-in-production
JWT_EXPIRY=86400

# Encryption
ENCRYPTION_ALGORITHM=aes-256-gcm
ENCRYPTION_KEY=your-encryption-key-base64-encoded

# Password Hashing
ARGON2_TIME=3
ARGON2_MEMORY=65536
ARGON2_PARALLELISM=4

# Rate Limiting
RATE_LIMIT_WINDOW_MS=3600000
RATE_LIMIT_MAX_REQUESTS=1000
RATE_LIMIT_SYNC_WINDOW_MS=60000
RATE_LIMIT_SYNC_MAX_REQUESTS=50

# Logging
LOG_LEVEL=info

# Sentry (Error Tracking)
SENTRY_DSN=

# Sync Configuration
SYNC_ENABLE_DOWNLOAD=true
SYNC_ENABLE_UPLOAD=true
SYNC_CONFLICT_STRATEGY=last-write-wins
SYNC_RETRY_MAX_ATTEMPTS=3
SYNC_RETRY_BACKOFF_BASE=1000
